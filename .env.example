# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Configuration for Server-side Media Management
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Apps Script Web App URL for automated email notifications
VITE_EMAIL_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbyycTvyKBXb1Qttc2lYj_laav_UTu1Yuv7FSekVhnZOA92MZltSudZchpXsb5HGbt8dCA/exec"

# Resend Configuration (Removed, using Gmail SMTP now)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx" # Đây là Mật khẩu ứng dụng (App Password)
NOTIFY_EMAIL="your-email@gmail.com"

