rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm hỗ trợ xác thực cán bộ
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Dữ liệu công khai phục vụ người dân tra cứu thông tin
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /documents/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /competitions/{compId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /memberOrganizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Dân nguyện & Phản ánh kiến nghị: Người dân gửi ý kiến, cán bộ xử lý
    match /publicOpinions/{opinionId} {
      allow read: if true;
      allow create: if request.resource.data.content != null;
      allow update, delete: if isAuthenticated();
    }

    // 3. Thi trực tuyến & Đăng ký tình nguyện viên
    match /competitionSubmissions/{subId} {
      allow read: if true;
      allow create: if request.resource.data.participantName != null;
      allow update, delete: if isAuthenticated();
    }

    match /volunteerRegistrations/{regId} {
      allow create: if request.resource.data.fullName != null;
      allow read, update, delete: if isAuthenticated();
    }

    // Email Notification System Collections
    match /article_submissions/{subId} {
      allow read: if true;
      allow create: if request.resource.data.title != null && request.resource.data.content != null;
      allow update, delete: if isAuthenticated();
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.feedbackCode != null && request.resource.data.content != null;
      allow update, delete: if isAuthenticated();
    }

    match /notifications/{notiId} {
      allow read, write: if isAuthenticated();
    }

    match /email_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /system_settings/{settingsId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Thống kê truy cập & giám sát thời gian thực
    match /analytics_stats/{docId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /active_visitors/{sessionId} {
      allow read, write: if true;
    }

    // 5. Cán bộ & Tài khoản nội bộ
    match /staff_users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /internal_notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /document_plans/{planId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Mặc định các collection nội bộ khác: Chỉ cán bộ đã đăng nhập
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}



