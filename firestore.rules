rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    
    // Get user role document from staff_users
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/staff_users/$(uid)).data.role;
    }
    
    function isAdmin() { return isSignedIn() && getUserRole(request.auth.uid) == 'admin'; }
    function isStaff() { return isSignedIn() && (getUserRole(request.auth.uid) == 'admin' || getUserRole(request.auth.uid) == 'staff'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- Collections ---

    // 1. Public Portal (Read-only for guests, Admin write)
    match /articles/{articleId} { allow read: if true; allow write: if isAdmin(); }
    match /documents/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /competitions/{compId} { allow read: if true; allow write: if isAdmin(); }
    match /memberOrganizations/{orgId} { allow read: if true; allow write: if isAdmin(); }
    match /areas/{areaId} { allow read: if true; allow write: if isAdmin(); }
    match /organizations/{orgId} { allow read: if true; allow write: if isAdmin(); }

    // 2. Public Opinions (Owner access + Staff/Admin access)
    match /publicOpinions/{opinionId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // 3. Submissions/Registrations
    match /competitionSubmissions/{subId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /volunteerRegistrations/{regId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // 4. Notifications/Email (User restricted)
    match /notifications/{notiId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /email_logs/{logId} { allow read, write: if isStaff(); }

    // 5. System/Internal (Admin only)
    match /system_settings/{settingsId} { allow read: if true; allow write: if isAdmin(); }
    match /staff_users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} { allow read, write: if isAdmin(); }
    match /internal_notes/{noteId} { allow read, write: if isStaff(); }

    // Catch-all: Deny all by default
    match /{document=**} { allow read, write: if false; }
  }
}
