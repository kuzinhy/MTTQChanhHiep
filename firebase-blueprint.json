{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Public users and profile records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "staffUsers": {
      "title": "Staff Users",
      "description": "Authorized staff allowlist and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullname": { "type": "string" },
        "position": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "articles": {
      "title": "News Articles",
      "description": "CMS Articles for Public Portal",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "featuredImage": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "authorName": { "type": "string" },
        "publishDate": { "type": "string" },
        "views": { "type": "number" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["title", "category", "status"]
    },
    "documents": {
      "title": "Official Documents",
      "description": "Public and internal legal documents",
      "type": "object",
      "properties": {
        "codeNumber": { "type": "string" },
        "title": { "type": "string" },
        "docType": { "type": "string" },
        "issuer": { "type": "string" },
        "issueDate": { "type": "string" },
        "effectiveDate": { "type": "string" },
        "signer": { "type": "string" },
        "field": { "type": "string" },
        "fileUrl": { "type": "string" },
        "isPublic": { "type": "boolean" }
      },
      "required": ["codeNumber", "title", "docType"]
    },
    "competitions": {
      "title": "Online Competitions",
      "description": "Trivia and Writing Competitions",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "timeLimitMinutes": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "rules": { "type": "string" }
      },
      "required": ["title", "type", "status"]
    },
    "publicOpinions": {
      "title": "Public Opinions & Feedback",
      "description": "Citizen feedback and social opinion reflections",
      "type": "object",
      "properties": {
        "receiptCode": { "type": "string" },
        "topic": { "type": "string" },
        "content": { "type": "string" },
        "neighborhood": { "type": "string" },
        "fullname": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "assignedTo": { "type": "string" },
        "adminResponse": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["receiptCode", "topic", "content", "status"]
    },
    "tasks": {
      "title": "Work Tasks",
      "description": "Task management for MTTQ staff",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assigneeId": { "type": "string" },
        "assigneeName": { "type": "string" },
        "assignerName": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "status", "priority"]
    },
    "events": {
      "title": "Work Schedule & Events",
      "description": "Calendar events for MTTQ Chanh Hiep",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "chair": { "type": "string" },
        "participants": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "startTime", "endTime"]
    },
    "notes": {
      "title": "Personal Notes",
      "description": "Staff personal scratchpad notes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title"]
    },
    "auditLogs": {
      "title": "Audit Logs",
      "description": "System activity logs for security auditing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "analytics_stats": {
      "title": "Analytics Stats",
      "description": "Real-time visitor counts and active online visitors",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "todayVisits": { "type": "number" },
        "monthVisits": { "type": "number" },
        "lastDate": { "type": "string" },
        "lastMonth": { "type": "string" }
      },
      "required": ["totalVisits"]
    },
    "active_visitors": {
      "title": "Active Visitors",
      "description": "Heartbeat timestamps for calculating real-time active online visitors",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "lastActive": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["sessionId", "lastActive"]
    },
    "areas": {
      "title": "Areas & Administrative Units",
      "description": "Administrative boundaries (ward, neighborhoods, residential groups)",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "parentId": { "type": "string" },
        "order": { "type": "number" },
        "description": { "type": "string" },
        "population": { "type": "number" },
        "householdsCount": { "type": "number" },
        "leaderName": { "type": "string" },
        "leaderPhone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "name", "type"]
    },
    "organizations": {
      "title": "Political & Front Organizations",
      "description": "Hierarchical organizations tree linked with administrative areas",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "slug": { "type": "string" },
        "type": { "type": "string" },
        "level": { "type": "string" },
        "parentId": { "type": "string" },
        "areaId": { "type": "string" },
        "leaderName": { "type": "string" },
        "leaderPosition": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "membersCount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "name", "type", "level"]
    },
    "memberOrganizations": {
      "title": "Member Organizations",
      "description": "Fatherland Front member organizations with hierarchical and geographic links",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "parentId": { "type": "string" },
        "areaId": { "type": "string" },
        "organizationId": { "type": "string" },
        "leaderName": { "type": "string" },
        "leaderPosition": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "activeMembersCount": { "type": "number" },
        "branchesCount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "shortName", "slug"]
    },
    "article_submissions": {
      "title": "Article Submissions",
      "description": "User submitted articles for editorial review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "unit": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "rejectionReason": { "type": "string" }
      },
      "required": ["id", "title", "content", "status", "createdAt"]
    },
    "feedback": {
      "title": "Feedback & Reflections",
      "description": "Citizen public feedback, complaints, and reflections with email notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feedbackCode": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "departmentId": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "feedbackCode", "title", "content", "status", "createdAt"]
    },
    "notifications": {
      "title": "Email Notifications Queue",
      "description": "Outgoing email notifications queue and status tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "eventKey": { "type": "string" },
        "relatedCollection": { "type": "string" },
        "relatedId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "sentAt": { "type": "string" },
        "failedAt": { "type": "string" },
        "retryCount": { "type": "number" },
        "errorMessage": { "type": "string" }
      },
      "required": ["id", "eventType", "eventKey", "recipientEmail", "subject", "status", "createdAt"]
    },
    "email_logs": {
      "title": "Email Delivery Logs",
      "description": "Historical logs of sent or failed email transmissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "recipient": { "type": "string" },
        "subject": { "type": "string" },
        "relatedId": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" },
        "sentAt": { "type": "string" },
        "errorMessage": { "type": "string" }
      },
      "required": ["id", "eventType", "recipient", "subject", "status", "createdAt"]
    },
    "email_settings": {
      "title": "Email Notification Settings",
      "description": "System configuration for email notifications and routing",
      "type": "object",
      "properties": {
        "systemWideEnabled": { "type": "boolean" },
        "newUserEnabled": { "type": "boolean" },
        "articleSubmittedEnabled": { "type": "boolean" },
        "articleApprovedEnabled: ": { "type": "boolean" },
        "articleRejectedEnabled": { "type": "boolean" },
        "feedbackSubmittedEnabled": { "type": "boolean" },
        "feedbackStatusChangedEnabled": { "type": "boolean" },
        "adminEmails": { "type": "array", "items": { "type": "string" } },
        "editorEmails": { "type": "array", "items": { "type": "string" } },
        "feedbackEmails": { "type": "array", "items": { "type": "string" } },
        "categoryRouting": { "type": "object" }
      }
    },
    "notification_reads": {
      "title": "Notification Read Status",
      "description": "User or device synchronized read notification status across sessions and devices",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "readNotificationIds": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["targetId", "readNotificationIds", "updatedAt"]
    }
  },
  "firestore": {
    "notification_reads/{id}": {
      "schema": "notification_reads",
      "description": "Cross-device synced notification read records"
    },
    "article_submissions/{id}": {
      "schema": "article_submissions",
      "description": "Article submissions for review"
    },
    "feedback/{id}": {
      "schema": "feedback",
      "description": "Citizen feedback items"
    },
    "notifications/{id}": {
      "schema": "notifications",
      "description": "Email notifications queue"
    },
    "email_logs/{id}": {
      "schema": "email_logs",
      "description": "Delivery logs"
    },
    "system_settings/email_notifications": {
      "schema": "email_settings",
      "description": "Global email config"
    }
  }
}
